{
  "name": "@dot-slash/browserstack-test-reporting",
  "publishConfig": {
    "access": "public"
  },
  "version": "7.2.1",
  "type": "module",
  "description": "BrowserStack Test Reporting & Analytics API client",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js",
      "require": "./dist/models.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit || true",
    "test": "vitest run"
  },
  "dependencies": {
    "@dot-slash/browserstack-app-automate": "workspace:*",
    "@dot-slash/browserstack-automate": "workspace:*"
  },
  "devDependencies": {
    "@dot-slash/browserstack-core": "workspace:*",
    "@dot-slash/browserstack-openapi": "workspace:*",
    "@dot-slash/browserstack-openapi-transforms": "workspace:*",
    "@types/node": "20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
